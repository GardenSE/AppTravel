<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:AppTravel.Features.M_Customer.ViewModels"
             x:Class="AppTravel.Features.M_Customer.Views.M_CustomerPage"
             x:DataType="viewModels:M_CustomerViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding Path=Title}">
    <VerticalStackLayout
        Margin="10, 20"
        Padding="5"
        Spacing="10">
    <Label 
            Text="{Binding Path=Message}"
            VerticalOptions="Start"
            HorizontalOptions="Start"
            WidthRequest="400"/>
    <Label 
            Text="顧客コード"
            WidthRequest="100"
            VerticalOptions="Start" 
            HorizontalOptions="Start" />
        <Entry 
            WidthRequest="150"
            VerticalOptions="Start" 
            HorizontalOptions="Start"
            Text="{Binding Path=CustomerCode, Mode=TwoWay}"
            />
        <Label 
             Text="顧客名"
             WidthRequest="100"
             VerticalOptions="Start" 
             HorizontalOptions="Start" />
        <Entry 
             WidthRequest="300"
             VerticalOptions="Start" 
             HorizontalOptions="Start"
             Text="{Binding Path=CustomerName, Mode=TwoWay}"/>
        <Label 
            Text="メールアドレス"
            WidthRequest="100"
            VerticalOptions="Start" 
            HorizontalOptions="Start"/>
        <Entry 
               Keyboard="Email" 
               WidthRequest="400"
               VerticalOptions="Start" 
               HorizontalOptions="Start"
               Text="{Binding Path=MailAddress, Mode=TwoWay}"/>
    <Button 
                Text="保存" 
                TextColor="Red"
                WidthRequest="100"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Command="{Binding Path=SaveCommand}" />
    <Button 
                Text="クリア"
                TextColor="Blue"
                WidthRequest="100"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Command="{Binding Path=ClearCommand}" />

  </VerticalStackLayout>
</ContentPage>