<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppTravel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c_top="clr-namespace:AppTravel.Features.C_Top.Views"
    xmlns:m_customer="clr-namespace:AppTravel.Features.M_Customer.Views"
    xmlns:m_course="clr-namespace:AppTravel.Features.M_Course.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="AppTravel">

    <FlyoutItem Title="トップ">
        <ShellContent
            ContentTemplate="{DataTemplate c_top:C_Top}" />
    </FlyoutItem>
    <FlyoutItem Title="顧客マスタ登録">
        <ShellContent
            ContentTemplate="{DataTemplate m_customer:M_Customer}" />
    </FlyoutItem>

    <FlyoutItem Title="コースマスタ登録">
        <ShellContent
            ContentTemplate="{DataTemplate m_course:M_Course}" />
    </FlyoutItem>
</Shell>
